# agents: several agents in one window, each saying when it needs you, inside the window:
# a thin progress bar along a pane's top (red on an error), and a bell before a tab's title
# a smaller window, so the 880 px GIF shows the tab's bell and the 2-pt bar larger (the
# frames' size is the window's): no frames until it has its size
hold 1500
ctl {"cmd":"window","rect":[560,290,800,500]}
sleep 1500
ctl {"cmd":"action","action":"new_split:right"}
sleep 900
# agent A, in the right pane: a long job with progress, then a bell when it's done
# (ci/demo/agents/*.ps1, copied into C:\demo by the job)
text .\agent-a.ps1\n
sleep 2500
# meanwhile, a second tab: agent B, whose tests fail (the bar turns red)
key t ctrl,shift
sleep 1200
text .\agent-b.ps1\n
sleep 7500
# agent A has rung: its tab has the bell. Back to it, and the bell goes.
key tab ctrl
sleep 2800
