# focus: full screen with F11, bigger type, the bar the mouse reveals at the top, its "?", and back
sleep 500
text echo full screen with F11\n
sleep 900
# no frames while Windows resizes the window: the frame before stays, then the full screen
hold 900
key f11
sleep 1000
# Ctrl+= eight times: type you can read from across the room
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 90
key = ctrl
sleep 700
text echo nothing but the terminal\n
sleep 1200
# the mouse at the top edge slides the bar down
move 0.5 0.5 300
sleep 200
move 0.5 0.0 700
sleep 1500
# the bar's "?": the overview. "list" names it while the bar shows (lane A, 69f1c5a73); an
# older build names none, and then it's clicked by its place (46 px buttons at 96 dpi).
clickrect help 0.964 0.012
sleep 2200
vkey escape
sleep 600
key 0 ctrl
sleep 500
hold 900
key f11
sleep 1400
